---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import EventCard from "../components/EventCard.astro";
import newsData from "../data/news.generated.json";
import eventsData from "../data/events.generated.json";
import changelog from "../data/changelog.generated.json";

const formatDate = (value) => value
  ? new Intl.DateTimeFormat("de-DE", { day: "2-digit", month: "long", year: "numeric", timeZone: "Europe/Berlin" }).format(new Date(value))
  : "Noch nicht veröffentlicht";

const today = new Intl.DateTimeFormat("sv-SE", { timeZone: "Europe/Berlin" }).format(new Date());
const upcomingEvents = eventsData.items.filter((event) => event.date >= today).slice(0, 3);

const relativeLabel = (date) => {
  const difference = Math.round((new Date(`${date}T12:00:00Z`) - new Date(`${today}T12:00:00Z`)) / 86400000);
  if (difference === 0) return "Heute";
  if (difference === 1) return "Morgen";
  return null;
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Neuigkeiten und die letzten Änderungen aus der öffentlichen DIE Drachenhalle."
    />
    <link rel="icon" type="image/png" href="/zroute_die/favicon.png" />
    <title>Aktuelles · DIE Drachenhalle</title>
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader active="news" />

      <main class="news-main" id="main-content">
        <section class="welcome-hero" aria-labelledby="welcome-title">
          <div class="welcome-copy">
            <p class="eyebrow">Die Drachenritter · DIE</p>
            <h1 id="welcome-title">Willkommen in der Drachenhalle</h1>
            <p>
              Der gemeinsame Ort für Neuigkeiten, Termine, Wissen und die Geschichten unserer Allianz.
            </p>
            <div class="welcome-links">
              <a href="#neuigkeiten">Was ist neu? <span aria-hidden="true">↓</span></a>
              <a href="/zroute_die/termine/">Nächste Termine <span aria-hidden="true">→</span></a>
            </div>
            <dl class="archive-stats" aria-label="Aktueller Umfang">
              <div><dt>{newsData.items.length}</dt><dd>Meldungen</dd></div>
              <div><dt>{upcomingEvents.length}</dt><dd>Nächste Termine</dd></div>
            </dl>
          </div>
          <figure class="welcome-visual">
            <img
              src="/zroute_die/brand/die-drachenhalle-willkommen.webp"
              width="1600"
              height="900"
              alt="Von links stehen Somea, mysteryZ, Leader Anthlan, Drachenherz und DaVinci1986 am Strategietisch der Drachenhalle."
              fetchpriority="high"
            />
            <figcaption>Anthlan und die vier offiziellen Offiziere der Drachenritter.</figcaption>
          </figure>
        </section>

        <section class="news-section" id="neuigkeiten" aria-labelledby="news-list-title">
          <header class="content-section-heading">
            <div>
              <p class="eyebrow">Gezielt veröffentlicht</p>
              <h2 id="news-list-title">Neuigkeiten</h2>
            </div>
            <p>Wichtige Meldungen, neue Inhalte und Hinweise aus der Drachenhalle.</p>
          </header>

          {newsData.items.length > 0 ? (
            <div class="news-card-grid">
              {newsData.items.map((item, index) => (
                <a class:list={["news-card", { "is-featured": item.featured && index === 0 }]} href={item.url}>
                  <div class="news-card-meta">
                    <span>{item.category}</span>
                    <time datetime={item.date}>{formatDate(`${item.date}T12:00:00+02:00`)}</time>
                  </div>
                  <h3>{item.title}</h3>
                  <p>{item.summary}</p>
                  <strong>Weiterlesen →</strong>
                </a>
              ))}
            </div>
          ) : (
            <p class="news-empty">Noch sind keine Neuigkeiten veröffentlicht.</p>
          )}
        </section>

        <section class="events-preview" aria-labelledby="events-preview-title">
          <header class="content-section-heading">
            <div>
              <p class="eyebrow">Allianzplanung</p>
              <h2 id="events-preview-title">Nächste Termine</h2>
            </div>
            <p><a class="section-text-link" href="/zroute_die/termine/">Alle Termine ansehen →</a></p>
          </header>

          {upcomingEvents.length > 0 ? (
            <div class="event-list">
              {upcomingEvents.map((event) => (
                <EventCard event={event} compact relativeLabel={relativeLabel(event.date)} />
              ))}
            </div>
          ) : (
            <p class="events-empty">Aktuell sind keine kommenden Events eingetragen.</p>
          )}
        </section>

        <section class="changelog-section" aria-labelledby="changelog-title">
          <header class="content-section-heading">
            <div>
              <p class="eyebrow">Automatisch aus Git</p>
              <h2 id="changelog-title">Letztes Update</h2>
            </div>
            <p>Dieser Bereich wird bei jeder Veröffentlichung aus dem neuesten Commit erzeugt.</p>
          </header>

          <div class="changelog-card">
            <div class="changelog-summary">
              <time datetime={changelog.date ?? undefined}>{formatDate(changelog.date)}</time>
              <h3>{changelog.title}</h3>
            </div>
            {changelog.available && changelog.groups.length > 0 ? (
              <div class="changelog-groups">
                {changelog.groups.map((group) => (
                  <section>
                    <h4>{group.name}</h4>
                    <ul>
                      {group.items.map((item) => <li>{item}</li>)}
                    </ul>
                  </section>
                ))}
              </div>
            ) : (
              <p class="changelog-empty">Für diesen Stand konnten keine sichtbaren Änderungen ermittelt werden.</p>
            )}
          </div>
        </section>

        <section class="next-sections" aria-label="Bereiche der Drachenhalle">
          <a class="section-link" href="/zroute_die/galerie/">
            <span>01</span>
            <h2>Galerie</h2>
            <p>Chatbilder, Avatare und Charakterreferenzen durchsuchen.</p>
            <strong>Galerie öffnen →</strong>
          </a>
          <a class="section-link" href="/zroute_die/docs/">
            <span>02</span>
            <h2>Nützliches</h2>
            <p>Tipps und Spielwissen sowie Informationen zur Allianz.</p>
            <strong>Bereich öffnen →</strong>
          </a>
          <a class="section-link" href="/zroute_die/docs/styleguides/">
            <span>03</span>
            <h2>Styleguides</h2>
            <p>Verbindliche Bildsprache, Gestaltung und Textformatierung.</p>
            <strong>Bereich öffnen →</strong>
          </a>
        </section>
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
