---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import docsData from "../data/docs.generated.json";
import galleryData from "../data/gallery.generated.json";

const galleryItems = galleryData.items;
const categoryLabels = {
  Chatbild: "Chatbilder",
  Chibi: "Chibi",
  Avatar: "Avatare",
  Charaktermodell: "Charaktere",
  Allianz: "Allianz",
  Tipp: "Tipps",
  Anleitung: "Anleitungen",
  Stilguide: "Stilguide",
  Strategie: "Strategien",
  Analyse: "Analysen",
};
const categories = Object.entries(categoryLabels)
  .map(([value, label]) => ({
    value,
    label,
    count: galleryItems.filter((item) => item.category === value).length,
  }))
  .filter((category) => category.count > 0);
const people = [...new Set(galleryItems.flatMap((item) => item.people))].sort((left, right) =>
  left.localeCompare(right, "de"),
);
const styles = galleryData.styles;
const dateFormatter = new Intl.DateTimeFormat("de-DE", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date) => date ? dateFormatter.format(new Date(`${date}T00:00:00Z`)) : "Ohne Datum";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Das öffentliche Archiv der DIE-Allianz mit Chatbildern, Charaktermodellen, Tipps und Strategien."
    />
    <link rel="icon" type="image/svg+xml" href="/zroute_die/favicon.svg" />
    <title>DIE-Allianzarchiv</title>
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader active="gallery" />

      <main id="main-content">
        <section class="archive-intro" aria-labelledby="archive-title">
          <div>
            <p class="eyebrow">Öffentliches DIE-Archiv</p>
            <h1 id="archive-title">Bilder, Informationen und Geschichten der Allianz</h1>
          </div>
          <p class="intro-copy">
            Durchsuche Chatbilder, Charakterreferenzen und Allianzmaterial. Die Originale bleiben mit ihrer
            vollständigen Qualität und Historie im GitHub-Repository erhalten.
          </p>
          <dl class="archive-stats" aria-label="Archivumfang">
            <div><dt>{galleryData.imageCount}</dt><dd>Bilder</dd></div>
            <div><dt>{docsData.documentCount}</dt><dd>Dokumente</dd></div>
            <div><dt>10</dt><dd>Bereiche</dd></div>
          </dl>
        </section>

        <section class="gallery-section" id="galerie" aria-labelledby="gallery-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Das vollständige Bildarchiv</p>
              <h2 id="gallery-title">Galerie</h2>
            </div>
            <p class="gallery-hint">Bild auswählen, um die größere Ansicht und das Original zu öffnen.</p>
          </div>

          <div class="gallery-toolbar">
            <div class="category-list" role="group" aria-label="Nach Kategorie filtern">
              <button class="category-chip is-selected" type="button" data-category="all" aria-pressed="true">
                Alle <span>{galleryItems.length}</span>
              </button>
              {categories.map((category) => (
                <button class="category-chip" type="button" data-category={category.value} aria-pressed="false">
                  {category.label} <span>{category.count}</span>
                </button>
              ))}
            </div>

            <div class="people-filter">
              <label for="people-filter">Person</label>
              <select id="people-filter">
                <option value="all">Alle Personen</option>
                {people.map((person) => <option value={person}>{person}</option>)}
              </select>
            </div>

            <div class="gallery-select-filter">
              <label for="style-filter">Stil</label>
              <select id="style-filter">
                <option value="all">Alle Stile</option>
                {styles.map((style) => (
                  <option value={style.value}>{style.value} – {style.label} ({style.count})</option>
                ))}
              </select>
            </div>

            <p class="result-count" id="result-count" aria-live="polite">{galleryItems.length} Bilder</p>
          </div>

          <div class="gallery-grid" id="gallery-grid">
            {galleryItems.map((item, index) => (
              <article
                class="gallery-card"
                data-category={item.category}
                data-people={item.people.join("|")}
                data-style={item.style ?? ""}
                data-style-label={item.styleLabel ?? ""}
                data-title={item.title}
                data-date={item.date ?? ""}
                data-date-label={formatDate(item.date)}
                data-web={item.webUrl}
                data-original={item.repositoryUrl}
              >
                <button class="gallery-open" type="button" aria-label={`${item.title} öffnen`}>
                  <div class="image-frame">
                    <img
                      src={item.thumbnailUrl}
                      alt={item.title}
                      loading={index < 8 ? "eager" : "lazy"}
                      decoding="async"
                    />
                    <span class="gallery-badges">
                      <span class="category-badge">{item.category}</span>
                      {item.style && <span class="style-badge" title={item.styleLabel}>{item.style}</span>}
                    </span>
                  </div>
                  <div class="card-copy">
                    <div>
                      <h3>{item.title}</h3>
                      <p>{item.people.length ? item.people.join(" · ") : "DIE"}</p>
                    </div>
                    <time datetime={item.date ?? undefined}>{formatDate(item.date)}</time>
                  </div>
                </button>
              </article>
            ))}
          </div>

          <div class="gallery-empty" id="gallery-empty" hidden>
            <strong>Keine passenden Bilder gefunden.</strong>
            <span>Wähle eine andere Kategorie, Person oder einen anderen Stil.</span>
          </div>
        </section>

        <section class="next-sections" aria-label="Weitere Archivbereiche">
          <a class="section-link" href="/zroute_die/docs/">
            <span>01</span>
            <h2>Nützliches</h2>
            <p>Tipps, Anleitungen, Strategien, Analysen und Allianzinformationen.</p>
            <strong>Bereich öffnen →</strong>
          </a>
          <a class="section-link" href="/zroute_die/docs/styleguides/">
            <span>02</span>
            <h2>Styleguides</h2>
            <p>Verbindliche Bildsprache, Gestaltung und Textformatierung.</p>
            <strong>Bereich öffnen →</strong>
          </a>
        </section>
      </main>

      <dialog class="gallery-dialog" id="gallery-dialog" aria-labelledby="detail-title">
        <div class="dialog-layout">
          <div class="dialog-stage">
            <button class="dialog-close" type="button" data-dialog-close aria-label="Detailansicht schließen">×</button>
            <img id="detail-image" alt="" />
            <div class="dialog-navigation" aria-label="Zwischen Bildern wechseln">
              <button type="button" id="detail-previous" aria-label="Vorheriges Bild">←</button>
              <span id="detail-position"></span>
              <button type="button" id="detail-next" aria-label="Nächstes Bild">→</button>
            </div>
          </div>
          <aside class="dialog-details">
            <p class="eyebrow" id="detail-category"></p>
            <h2 id="detail-title"></h2>
            <dl>
              <div><dt>Personen</dt><dd id="detail-people"></dd></div>
              <div><dt>Datum</dt><dd id="detail-date"></dd></div>
              <div id="detail-style-row"><dt>Stil</dt><dd id="detail-style"></dd></div>
            </dl>
            <a class="detail-original" id="detail-original" href="#" target="_blank" rel="noopener noreferrer">
              Original auf GitHub öffnen <span aria-hidden="true">↗</span>
            </a>
          </aside>
        </div>
      </dialog>

      <SiteFooter />
    </div>

    <script>
      const cards = [...document.querySelectorAll(".gallery-card")];
      const categoryButtons = [...document.querySelectorAll(".category-chip[data-category]")];
      const peopleFilter = document.querySelector("#people-filter");
      const styleFilter = document.querySelector("#style-filter");
      const resultCount = document.querySelector("#result-count");
      const emptyState = document.querySelector("#gallery-empty");
      const dialog = document.querySelector("#gallery-dialog");
      const detailImage = document.querySelector("#detail-image");
      const detailTitle = document.querySelector("#detail-title");
      const detailCategory = document.querySelector("#detail-category");
      const detailPeople = document.querySelector("#detail-people");
      const detailDate = document.querySelector("#detail-date");
      const detailStyle = document.querySelector("#detail-style");
      const detailStyleRow = document.querySelector("#detail-style-row");
      const detailOriginal = document.querySelector("#detail-original");
      const detailPosition = document.querySelector("#detail-position");
      const previousButton = document.querySelector("#detail-previous");
      const nextButton = document.querySelector("#detail-next");
      let selectedCategory = "all";
      let visibleCards = cards;
      let currentIndex = 0;

      function applyFilters() {
        const selectedPerson = peopleFilter.value;
        const selectedStyle = styleFilter.value;
        visibleCards = cards.filter((card) => {
          const categoryMatches = selectedCategory === "all" || card.dataset.category === selectedCategory;
          const people = (card.dataset.people ?? "").split("|").filter(Boolean);
          const personMatches = selectedPerson === "all" || people.includes(selectedPerson);
          const styleMatches = selectedStyle === "all" || card.dataset.style === selectedStyle;
          const visible = categoryMatches && personMatches && styleMatches;
          card.hidden = !visible;
          return visible;
        });

        resultCount.textContent = `${visibleCards.length} ${visibleCards.length === 1 ? "Bild" : "Bilder"}`;
        emptyState.hidden = visibleCards.length !== 0;
      }

      function showCard(card) {
        currentIndex = visibleCards.indexOf(card);
        detailImage.src = card.dataset.web;
        detailImage.alt = card.dataset.title;
        detailTitle.textContent = card.dataset.title;
        detailCategory.textContent = card.dataset.category;
        detailPeople.textContent = card.dataset.people ? card.dataset.people.split("|").join(" · ") : "DIE";
        detailDate.textContent = card.dataset.dateLabel;
        const hasStyle = Boolean(card.dataset.style);
        detailStyleRow.hidden = !hasStyle;
        detailStyle.textContent = hasStyle ? `${card.dataset.style} – ${card.dataset.styleLabel}` : "";
        detailOriginal.href = card.dataset.original;
        detailPosition.textContent = `${currentIndex + 1} / ${visibleCards.length}`;
        previousButton.disabled = visibleCards.length < 2;
        nextButton.disabled = visibleCards.length < 2;

        if (!dialog.open) {
          dialog.showModal();
          document.documentElement.classList.add("dialog-open");
        }
      }

      categoryButtons.forEach((button) => {
        button.addEventListener("click", () => {
          selectedCategory = button.dataset.category;
          categoryButtons.forEach((item) => {
            const selected = item === button;
            item.classList.toggle("is-selected", selected);
            item.setAttribute("aria-pressed", String(selected));
          });
          applyFilters();
        });
      });

      peopleFilter.addEventListener("change", applyFilters);
      styleFilter.addEventListener("change", applyFilters);
      cards.forEach((card) => card.querySelector(".gallery-open").addEventListener("click", () => showCard(card)));

      previousButton.addEventListener("click", () => {
        currentIndex = (currentIndex - 1 + visibleCards.length) % visibleCards.length;
        showCard(visibleCards[currentIndex]);
      });

      nextButton.addEventListener("click", () => {
        currentIndex = (currentIndex + 1) % visibleCards.length;
        showCard(visibleCards[currentIndex]);
      });

      document.querySelector("[data-dialog-close]").addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener("close", () => {
        document.documentElement.classList.remove("dialog-open");
        detailImage.removeAttribute("src");
      });

      dialog.addEventListener("keydown", (event) => {
        if (visibleCards.length < 2) return;

        if (event.key === "ArrowLeft") {
          event.preventDefault();
          previousButton.click();
        }

        if (event.key === "ArrowRight") {
          event.preventDefault();
          nextButton.click();
        }
      });
    </script>
  </body>
</html>
