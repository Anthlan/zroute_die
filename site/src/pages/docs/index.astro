---
import "../../styles/global.css";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import docsData from "../../data/docs.generated.json";

const itemBySlug = new Map(docsData.items.map((item) => [item.slug, item]));
const informationSection = docsData.sections.find((section) => section.name === "Informationen");
const usefulDocuments = informationSection
  ? informationSection.items.map((slug) => itemBySlug.get(slug)).filter(Boolean)
  : [];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Tipps, Anleitungen, Strategien, Analysen und Allianzinformationen des DIE-Allianzarchivs."
    />
    <link rel="icon" type="image/svg+xml" href="/zroute_die/favicon.svg" />
    <title>Nützliches · DIE-Allianzarchiv</title>
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader active="informationen" />

      <main class="docs-main" id="main-content">
        <section class="docs-intro" aria-labelledby="docs-title">
          <p class="eyebrow">Informationen</p>
          <h1 id="docs-title">Nützliches</h1>
          <p>
            Tipps, Anleitungen, Strategien, Analysen und Informationen zur Allianz – direkt aus den
            Markdown-Dateien des Repositorys erzeugt.
          </p>
          <dl class="archive-stats" aria-label="Umfang der nützlichen Inhalte">
            <div><dt>{usefulDocuments.length}</dt><dd>Themen</dd></div>
          </dl>
        </section>

        <section class="docs-library docs-collection" aria-label="Nützliche Inhalte">
          <div class="docs-card-grid">
            {usefulDocuments.map((item) => (
              <a class="docs-card" href={item.url}>
                <span>{item.section}</span>
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
                <strong>Lesen →</strong>
              </a>
            ))}
          </div>
        </section>
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
