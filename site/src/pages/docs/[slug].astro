---
import "../../styles/global.css";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import docsData from "../../data/docs.generated.json";

export function getStaticPaths() {
  return docsData.items.map((document) => ({
    params: { slug: document.slug },
    props: { document },
  }));
}

const { document } = Astro.props;
const topLevelSectionDocuments = docsData.items.filter(
  (item) => item.section === document.section && !item.parentSlug,
);
const activeCollectionSlug = document.parentSlug ?? document.slug;
const childDocuments = docsData.items.filter((item) => item.parentSlug === activeCollectionSlug);
const sectionDocuments = topLevelSectionDocuments.flatMap((item) =>
  item.slug === activeCollectionSlug ? [item, ...childDocuments] : [item],
);
const activeSection = document.section === "Gestaltung"
  ? "gestaltung"
  : document.section === "Informationen"
    ? "informationen"
    : "";
const overviewUrl = document.section === "Gestaltung" ? "/zroute_die/docs/styleguides/" : "/zroute_die/docs/";
const overviewLabel = document.section === "Gestaltung" ? "Styleguides" : "Nützliches";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={document.summary} />
    <link rel="icon" type="image/svg+xml" href="/zroute_die/favicon.svg" />
    <title>{document.title} · DIE-Allianzarchiv</title>
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader active={activeSection} />

      <main class="document-main" id="main-content">
        <nav class="breadcrumbs" aria-label="Brotkrümelnavigation">
          <a href="/zroute_die/">Start</a>
          <span aria-hidden="true">/</span>
          <a href={overviewUrl}>{overviewLabel}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{document.title}</span>
        </nav>

        <div class:list={["document-layout", { "is-knowledge-page": document.imageUrl }]}>
          <aside class="document-sidebar">
            <p class="eyebrow">{document.section}</p>
            <a class="docs-overview-link" href={overviewUrl}>← {overviewLabel}</a>
            {sectionDocuments.length > 0 && (
              <nav class="document-section-nav" aria-label={`Weitere Dokumente aus ${document.section}`}>
                <span>In diesem Bereich</span>
                {sectionDocuments.map((item) => (
                  <a
                    class:list={[{ "is-current": item.slug === document.slug, "is-child": item.parentSlug }]}
                    href={item.url}
                    aria-current={item.slug === document.slug ? "page" : undefined}
                  >
                    {item.title}
                  </a>
                ))}
              </nav>
            )}
            {sectionDocuments.length > 0 && (
              <details class="document-mobile-nav">
                <summary>
                  <span>In diesem Bereich</span>
                  <strong>{document.title}</strong>
                </summary>
                <nav aria-label={`Dokumente aus ${document.section}`}>
                  {sectionDocuments.map((item) => (
                    <a
                      class:list={[{ "is-current": item.slug === document.slug, "is-child": item.parentSlug }]}
                      href={item.url}
                      aria-current={item.slug === document.slug ? "page" : undefined}
                    >
                      {item.title}
                    </a>
                  ))}
                </nav>
              </details>
            )}
          </aside>

          <article class="document-article">
            <header>
              <p class="eyebrow">{document.section}</p>
              <h1>{document.title}</h1>
              <p>{document.summary}</p>
              <a href={document.repositoryUrl} target="_blank" rel="noopener noreferrer">
                Markdown auf GitHub öffnen <span aria-hidden="true">↗</span>
              </a>
            </header>
            {childDocuments.length > 0 && !document.parentSlug && (
              <section class="knowledge-children" aria-labelledby="knowledge-children-title">
                <div>
                  <p class="eyebrow">Informationsseiten</p>
                  <h2 id="knowledge-children-title">Verfügbare Tipps</h2>
                </div>
                <div class="knowledge-card-list">
                  {childDocuments.map((item) => (
                    <a class="knowledge-card" href={item.url}>
                      <div>
                        <span>Informationen · Tipp</span>
                        <h3>{item.title}</h3>
                        <p>{item.summary}</p>
                        <strong>Informationsseite öffnen →</strong>
                      </div>
                      {item.imageUrl && <img src={item.imageUrl} alt="" loading="lazy" />}
                    </a>
                  ))}
                </div>
              </section>
            )}
            {document.kind === "tip" && document.hasBriefView ? (
              <div class="tip-viewer" data-tip-viewer>
                <div class="tip-view-switcher" role="group" aria-label="Ansicht des Tipps auswählen">
                  <button
                    type="button"
                    class="is-active"
                    aria-pressed="true"
                    aria-controls="kurz"
                    data-tip-view-button="brief"
                  >
                    Kurz &amp; knapp
                  </button>
                  <button
                    type="button"
                    aria-pressed="false"
                    aria-controls="ausfuehrlich"
                    data-tip-view-button="detail"
                  >
                    Ausführlich
                  </button>
                </div>

                <div class:list={["tip-switch-layout", { "has-aside-image": document.imageUrl }]}>
                  <div class="tip-view-content">
                    <section
                      id="kurz"
                      class="markdown-content tip-view tip-view-brief"
                      data-tip-view="brief"
                      set:html={document.briefHtml}
                    />
                    <section
                      id="ausfuehrlich"
                      class="tip-view tip-view-detail"
                      data-tip-view="detail"
                    >
                      <div class="markdown-content tip-detail-intro" set:html={document.detailIntroHtml} />
                      <div class="markdown-content tip-detail-body" set:html={document.detailBodyHtml} />
                    </section>
                  </div>

                  {document.imageUrl && (
                    <aside class="document-visual tip-shared-visual" aria-label="Zugehörige Tipp-Grafik">
                      <a href={document.imageRepositoryUrl} target="_blank" rel="noopener noreferrer">
                        <img src={document.imageUrl} alt={`Grafik zu ${document.title}`} />
                      </a>
                      <p>Passende Grafik zum Teilen im Allianzchat.</p>
                      <a href={document.imageRepositoryUrl} target="_blank" rel="noopener noreferrer">
                        Originalgrafik auf GitHub öffnen <span aria-hidden="true">↗</span>
                      </a>
                    </aside>
                  )}
                </div>
              </div>
            ) : document.kind === "tip" && document.introHtml && document.tipHtml && document.copyHtml ? (
              <div class="tip-article-body">
                <section class="markdown-content tip-intro" set:html={document.introHtml} />
                <div class:list={["tip-main-layout", { "has-aside-image": document.imageUrl }]}> 
                  <section class="markdown-content tip-main-content" set:html={document.tipHtml} />
                  {document.imageUrl && (
                    <aside class="document-visual" aria-label="Zugehörige Tipp-Grafik">
                      <a href={document.imageRepositoryUrl} target="_blank" rel="noopener noreferrer">
                        <img src={document.imageUrl} alt={`Grafik zu ${document.title}`} />
                      </a>
                      <p>Passende Grafik zum Teilen im Allianzchat.</p>
                      <a href={document.imageRepositoryUrl} target="_blank" rel="noopener noreferrer">
                        Originalgrafik auf GitHub öffnen <span aria-hidden="true">↗</span>
                      </a>
                    </aside>
                  )}
                </div>
                <section class="markdown-content tip-copy" set:html={document.copyHtml} />
              </div>
            ) : (
              <div class="markdown-content" set:html={document.html} />
            )}
          </article>
        </div>
      </main>

      <SiteFooter />
    </div>

    <script>
      const tipViewers = document.querySelectorAll("[data-tip-viewer]");

      for (const viewer of tipViewers) {
        if (!(viewer instanceof HTMLElement)) continue;

        const buttons = [...viewer.querySelectorAll("[data-tip-view-button]")];
        const views = [...viewer.querySelectorAll("[data-tip-view]")];

        const showView = (viewName, updateFragment = false) => {
          const activeView = viewName === "detail" ? "detail" : "brief";
          viewer.dataset.activeView = activeView;

          for (const button of buttons) {
            const isActive = button.getAttribute("data-tip-view-button") === activeView;
            button.classList.toggle("is-active", isActive);
            button.setAttribute("aria-pressed", String(isActive));
          }

          for (const view of views) {
            const isActive = view.getAttribute("data-tip-view") === activeView;
            view.classList.toggle("is-active", isActive);
            view.setAttribute("aria-hidden", String(!isActive));
          }

          if (updateFragment) {
            const fragment = activeView === "detail" ? "#ausfuehrlich" : "#kurz";
            history.replaceState(null, "", fragment);
          }
        };

        const viewFromFragment = () => {
          if (window.location.hash === "#kurz") return "brief";
          if (window.location.hash === "#ausfuehrlich") return "detail";

          const target = window.location.hash
            ? document.getElementById(decodeURIComponent(window.location.hash.slice(1)))
            : null;
          return target?.closest('[data-tip-view="detail"]') ? "detail" : "brief";
        };

        viewer.classList.add("is-enhanced");
        showView(viewFromFragment());

        for (const button of buttons) {
          button.addEventListener("click", () => {
            showView(button.getAttribute("data-tip-view-button") ?? "brief", true);
          });
        }

        window.addEventListener("hashchange", () => {
          const activeView = viewFromFragment();
          showView(activeView);
          const target = window.location.hash
            ? document.getElementById(decodeURIComponent(window.location.hash.slice(1)))
            : null;
          if (target && window.location.hash !== "#kurz" && window.location.hash !== "#ausfuehrlich") {
            requestAnimationFrame(() => target.scrollIntoView());
          }
        });
      }
    </script>
  </body>
</html>
